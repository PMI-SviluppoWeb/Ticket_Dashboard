# Porta di default su cui gira la dashboard (la app V1 resta sulla 3000).
PORT=3001

# Database Turso (libSQL). URL e token si trovano su turso.tech:
#   - dashboard: Database → "Show URL"
#   - Settings → Auth Tokens → Create token (scopo read-write)
# Il token resta SOLO lato server (variabile non pubblica).
TURSO_DATABASE_URL=libsql://ticket-dashboard-ORG.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Secret per la firma JWT (cambia in produzione!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Segreto condiviso app <-> IMAP worker per il webhook /api/hooks/email.
# OBBLIGATORIO in produzione: senza, il server rifiuta le richieste webhook.
WEBHOOK_SECRET=cambia-questo-anche-lui-in-produzione

# Chiave di cifratura per le password delle caselle email configurate
# dall'app (/admin/email). Obbligatoria per salvare/leggere le caselle nel
# database: senza, il form resta disabilitato. Almeno 32 caratteri.
# ATTENZIONE: cambiarla rende illeggibili le password gia' salvate.
ENCRYPTION_KEY=cambia-questa-chiave-in-produzione-32-char-min

# Email SMTP (Gmail)
# Per Gmail: usa una "Password app" generate da https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Support Desk <tua-email@gmail.com>"

# SQL Server - Sorgente anagrafiche clienti (per sync)
SQL_SERVER=tuo-server-sql
SQL_DATABASE=tuo-database
SQL_USER=utente
SQL_PASS=password
SQL_ENCRYPT=true
SQL_TRUST_CERT=false

# API Arca (opzionale - per sync alternativa via API)
# ARCA_API_BASE_URL=http://tuoserver/api
# ARCA_API_KEY=la-tua-api-key

# --- Google Calendar (sincronizzazione app -> Google, una direzione) ---
# Opzionale: senza queste variabili la sincronizzazione resta disattivata e
# l'app funziona normalmente. Vedi "Integrazione Google Calendar" in DEPLOY.md.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=account-di-servizio@progetto.iam.gserviceaccount.com
# La chiave PEM su UNA RIGA, con gli a-capo scritti come \n.
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
