# Porta di default su cui gira la dashboard (la app V1 resta sulla 3000).
PORT=3001

# Database Turso (libSQL). URL e token si trovano su turso.tech:
#   - dashboard: Database → "Show URL"
#   - Settings → Auth Tokens → Create token (scopo read-write)
# Il token resta SOLO lato server (variabile non pubblica).
TURSO_DATABASE_URL=libsql://ticket-dashboard-ORG.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Secret per la firma JWT (cambia in produzione!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Email SMTP (Gmail)
# Per Gmail: usa una "Password app" generate da https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tua-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Support Desk <tua-email@gmail.com>"
