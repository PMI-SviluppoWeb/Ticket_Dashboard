# ============================================
# Ticket Dashboard - Variabili d'ambiente Docker
# ============================================
# Copia questo file in .env e compila i valori

# --- Database Turso ---
TURSO_DATABASE_URL=libsql://tuo-database-turso
TURSO_AUTH_TOKEN=il-tuo-auth-token

# --- JWT ---
JWT_SECRET=cambia-questo-secret-in-produzione

# --- Webhook email (app <-> IMAP worker, stesso valore nei due lati) ---
# OBBLIGATORIO in produzione: senza, /api/hooks/email risponde 503.
WEBHOOK_SECRET=cambia-questo-webhook-secret

# --- SMTP (invio email) ---
SMTP_HOST=il-tuo-server-smtp
SMTP_PORT=465
SMTP_USER=la-tua-email
SMTP_PASS=la-tua-password
EMAIL_FROM="Support Desk <la-tua-email>"

# --- IMAP (ricezione email) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=la-tua-email
IMAP_PASS=la-tua-password-app
IMAP_SECURE=true
IMAP_POLL_INTERVAL_MS=300000

# --- SQL Server (sync clienti) ---
SQL_SERVER=SRV2022\SQLEXPRESS
SQL_DATABASE=ADB_PMISOFTWARE
SQL_USER=utente
SQL_PASS=password
SQL_ENCRYPT=false
SQL_TRUST_CERT=false

# --- OpenRouter (classificazione AI) ---
OPENROUTER_API_KEY=sk-or-v1-xxx

# --- SQL Server Auth ---
SQL_WINDOWS_AUTH=true
SQL_DOMAIN=PMISoftware

# --- Google Calendar (sincronizzazione app -> Google, una direzione) ---
# 1) Google Cloud Console: abilita "Google Calendar API"
# 2) Crea un account di servizio e scarica la chiave JSON
# 3) Google Calendar: condividi il calendario di destinazione con l'email
#    dell'account di servizio, permesso "Apporta modifiche"
# Vedi la sezione "Integrazione Google Calendar" di DEPLOY.md.
GOOGLE_SERVICE_ACCOUNT_EMAIL=account-di-servizio@progetto.iam.gserviceaccount.com
# La chiave PEM va su UNA RIGA, con gli a-capo scritti come \n:
# env_file di docker-compose non accetta valori multi-riga.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"
